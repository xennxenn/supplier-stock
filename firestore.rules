rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidEmployee(data) {
      return data.id is string
        && data.name is string
        && data.name.size() > 0
        && data.role in ['admin', 'manager', 'staff']
        && data.perms is map;
    }

    function isValidOrderStatus(data) {
      return (data.barcode is string || data.itemKey is string)
        && (data.status is string || data.isOrdered is bool);
    }

    function isValidCustomTx(data) {
      return data.id is string
        && data.itemCode is string
        && data.type in ['in', 'out']
        && data.qty is number;
    }

    function isValidPurchaseOrder(data) {
      return data.id is string
        && data.poNumber is string
        && data.status in ['new', 'approved', 'confirm', 'received', 'cancelled']
        && data.items is list;
    }

    function isValidAppTheme(data) {
      return data.id is string;
    }

    function isValidBackup(data) {
      return data.id is string;
    }

    match /employees/{employeeId} {
      allow read: if true;
      allow create, update: if isValidEmployee(request.resource.data);
      allow delete: if true;
    }

    match /orderStatuses/{itemKey} {
      allow read: if true;
      allow create, update: if isValidOrderStatus(request.resource.data);
      allow delete: if true;
    }

    match /customTransactions/{txId} {
      allow read: if true;
      allow create, update: if isValidCustomTx(request.resource.data);
      allow delete: if true;
    }

    match /purchaseOrders/{orderId} {
      allow read: if true;
      allow create, update: if isValidPurchaseOrder(request.resource.data);
      allow delete: if true;
    }

    match /appSettings/{settingId} {
      allow read: if true;
      allow create, update: if isValidAppTheme(request.resource.data);
      allow delete: if true;
    }

    match /backups/{backupId} {
      allow read: if true;
      allow create, update: if isValidBackup(request.resource.data);
      allow delete: if true;
    }
  }
}

