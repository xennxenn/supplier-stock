{
  "entities": {
    "Employee": {
      "title": "Employee",
      "description": "User profile, credentials, and permission settings for staff, managers, and administrators.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the employee" },
        "name": { "type": "string", "description": "Full name of the employee" },
        "username": { "type": "string", "description": "Login username" },
        "password": { "type": "string", "description": "Login password" },
        "pin": { "type": "string", "description": "Quick PIN code" },
        "role": { "type": "string", "enum": ["admin", "manager", "staff"], "description": "Role level" },
        "department": { "type": "string", "description": "Assigned department or production line" },
        "employeeCode": { "type": "string", "description": "Official company employee code" },
        "perms": { "type": "object", "description": "Fine-grained feature permissions" },
        "allowedLines": { "type": "array", "description": "Allowed production lines" },
        "allowedSuppliers": { "type": "array", "description": "Allowed suppliers" }
      },
      "required": ["id", "name", "role", "perms"]
    },
    "OrderStatus": {
      "title": "OrderStatus",
      "description": "Tracking procurement and order status for stock items across production lines.",
      "type": "object",
      "properties": {
        "itemKey": { "type": "string", "description": "Unique identifier key of the stock item" },
        "status": { "type": "string", "enum": ["none", "ordering", "ordered", "received"], "description": "Procurement status" },
        "updatedAt": { "type": "string", "description": "Timestamp of last status update" },
        "updatedBy": { "type": "string", "description": "Name of the employee who updated the status" },
        "orderedQty": { "type": "number", "description": "Quantity ordered from supplier" },
        "prPoNumber": { "type": "string", "description": "Purchase Request / Purchase Order number" },
        "expectedDate": { "type": "string", "description": "Expected arrival date" },
        "note": { "type": "string", "description": "Additional notes" }
      },
      "required": ["itemKey", "status"]
    },
    "CustomTransaction": {
      "title": "CustomTransaction",
      "description": "In-app recorded stock in/out transactions.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique transaction ID" },
        "timestamp": { "type": "string", "description": "Date and time of movement" },
        "itemCode": { "type": "string", "description": "Stock item code" },
        "itemName": { "type": "string", "description": "Stock item name" },
        "type": { "type": "string", "enum": ["in", "out"], "description": "Transaction type" },
        "qty": { "type": "number", "description": "Quantity moved" }
      },
      "required": ["id", "timestamp", "itemCode", "type", "qty"]
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "description": "Purchase order containing line items filtered from alerts or forecast with status lifecycle: New, Approved, Confirm, Received.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier of the purchase order" },
        "poNumber": { "type": "string", "description": "Human-readable PO number" },
        "lotNumber": { "type": "string", "description": "Lot number assigned upon confirmation" },
        "title": { "type": "string", "description": "Purchase order title or description" },
        "status": { "type": "string", "enum": ["new", "approved", "confirm", "received"], "description": "Lifecycle status" },
        "createdAt": { "type": "string", "description": "ISO creation timestamp" },
        "updatedAt": { "type": "string", "description": "ISO update timestamp" },
        "createdBy": { "type": "string", "description": "Employee name who created this PO" },
        "createdById": { "type": "string", "description": "Employee ID who created this PO" },
        "approvedBy": { "type": "string", "description": "Employee name who approved this PO" },
        "confirmedBy": { "type": "string", "description": "Employee name who confirmed this PO" },
        "receivedBy": { "type": "string", "description": "Employee name who marked this PO received" },
        "safetyBufferPercent": { "type": "number", "description": "Safety buffer percentage applied" },
        "items": { "type": "array", "description": "List of line items in this order" },
        "totalItems": { "type": "number", "description": "Total number of items" },
        "totalOrderQty": { "type": "number", "description": "Total quantity ordered" },
        "totalCost": { "type": "number", "description": "Total cost of order" },
        "notes": { "type": "string", "description": "Additional notes" }
      },
      "required": ["id", "poNumber", "status", "items", "createdAt"]
    },
    "AppThemeSettings": {
      "title": "AppThemeSettings",
      "description": "Global application theme and liquid glass styling customized by admin.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "palette": { "type": "string" },
        "glassBlur": { "type": "string" },
        "ambientGlow": { "type": "boolean" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["id", "palette"]
    },
    "Backup": {
      "title": "Backup",
      "description": "Stock snapshot and transaction backups saved for system restore points.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ts": { "type": "string" },
        "itemsCount": { "type": "number" },
        "txCount": { "type": "number" },
        "kind": { "type": "string" },
        "data": { "type": "object" }
      },
      "required": ["id", "ts"]
    }
  },
  "firestore": {
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Synchronized employee profiles, credentials, and access permissions accessible across all devices."
    },
    "/orderStatuses/{itemKey}": {
      "schema": { "$ref": "#/entities/OrderStatus" },
      "description": "Real-time stock item procurement tracking and PR/PO status."
    },
    "/customTransactions/{txId}": {
      "schema": { "$ref": "#/entities/CustomTransaction" },
      "description": "Historical inventory receipts and dispatches recorded via the web application."
    },
    "/purchaseOrders/{orderId}": {
      "schema": { "$ref": "#/entities/PurchaseOrder" },
      "description": "Real-time purchase orders and procurement lot tracking."
    },
    "/appSettings/{settingId}": {
      "schema": { "$ref": "#/entities/AppThemeSettings" },
      "description": "System theme and Liquid Glass styling settings customized by administrators."
    },
    "/backups/{backupId}": {
      "schema": { "$ref": "#/entities/Backup" },
      "description": "System data snapshots and restore backups."
    }
  }
}
